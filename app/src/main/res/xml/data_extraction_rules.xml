<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 访问令牌只能由登录流程重新签发，不进入云备份。 -->
        <exclude domain="file" path="datastore/xinchat_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/xinchat_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
